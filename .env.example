# NextAuth v5
AUTH_SECRET=        # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000  # Public app URL for auth callbacks and emails

# OAuth credentials — can also be configured via /admin UI (recommended)
# Env vars here are used as fallback if not set in admin settings.
# GITHUB_ID=              # GitHub OAuth App Client ID
# GITHUB_SECRET=          # GitHub OAuth App Client Secret
# GOOGLE_CLIENT_ID=       # Google OAuth Client ID (optional)
# GOOGLE_CLIENT_SECRET=   # Google OAuth Client Secret (optional)

# ── Self-hosted mode (default) ──
# Option A: Configure S3 via /admin UI (local dev, Docker — writable filesystem)
# Option B: Set env vars below (Vercel deployment — read-only filesystem)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # Optional: custom endpoint for MinIO, R2, Wasabi
# INTERTOOL_ADMIN=username  # Optional: GitHub username of admin user
# GITHUB_ORG=               # Optional: restrict sign-in to members of this GitHub org
# INTERTOOL_API_KEY=        # Optional: API key for CLI publishing (generate: openssl rand -hex 32)
# CRON_SECRET=              # Required to protect scheduled /api/analytics calls in production

# ── Email invitations ──
# RESEND_API_KEY=           # Recommended email transport
# EMAIL_FROM=               # Optional sender address (default: noreply@AUTH_URL host)
# SMTP_HOST=                # Optional self-hosted SMTP transport; requires installing nodemailer
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── SaaS mode (intertool.sh) ──
# Uncomment to enable multi-tenant org-based routing.
# Each org gets a path: intertool.sh/{org}
# INTERTOOL_MODE=saas
# INTERTOOL_LOCAL_SAAS_FALLBACK=true  # Development only: store SaaS orgs locally when Redis is unavailable
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
