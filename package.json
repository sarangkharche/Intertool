{
  "name": "@intertool/web",
  "version": "0.1.0",
  "private": true,
  "description": "A shared, permission-aware memory layer for engineering teams",
  "homepage": "https://github.com/sarangkharche/Intertool",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarangkharche/Intertool.git"
  },
  "bugs": {
    "url": "https://github.com/sarangkharche/Intertool/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "mcp",
    "registry",
    "claude-code",
    "cursor",
    "prompt-templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://intertool:intertool@localhost:5432/intertool} pnpm --parallel --filter @intertool/web --filter @intertool/server run dev:service",
    "dev:service": "next dev",
    "dev:web": "next dev",
    "build": "pnpm build:web && pnpm --filter @intertool/server build",
    "build:web": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests && pnpm --filter @intertool/server lint && pnpm --filter @intertool/contracts lint && pnpm --filter @intertool/db lint && pnpm --filter @intertool/retrieval lint",
    "test:hooks": "python3 -m unittest discover -s claude-plugin/hooks -p 'test_*.py'",
    "test": "pnpm test:hooks && pnpm --filter @intertool/contracts test && pnpm --filter @intertool/retrieval test && pnpm --filter @intertool/server test",
    "test:integration": "DATABASE_URL=${DATABASE_URL:-postgresql://intertool:intertool@localhost:5432/intertool} pnpm --filter @intertool/server test:integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && pnpm --filter @intertool/contracts typecheck && pnpm --filter @intertool/db typecheck && pnpm --filter @intertool/retrieval typecheck && pnpm --filter @intertool/server typecheck",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://intertool:intertool@localhost:5432/intertool} pnpm --filter @intertool/db db:migrate",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://intertool:intertool@localhost:5432/intertool} pnpm --filter @intertool/db db:seed",
    "memory:import:codex": "tsx scripts/import-codex-memories.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@base-ui/react": "^1.3.0",
    "@pierre/diffs": "^1.1.1",
    "@types/mdx": "^2.0.13",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "framer-motion": "^12.38.0",
    "fumadocs-core": "^16.9.0",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-ui": "^16.9.0",
    "geist": "^1.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "@ts-morph/common": {
      "minimatch": {
        "brace-expansion": "^5.0.6"
      }
    },
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.2",
    "hono": "^4.12.21",
    "ip-address": "^10.2.0",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.15"
  }
}
