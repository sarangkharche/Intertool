{
  "name": "intertool",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hosted registry for AI agent skills, MCP servers, agent tools, and prompt templates",
  "homepage": "https://github.com/sarangkharche/Intertool",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarangkharche/Intertool.git"
  },
  "bugs": {
    "url": "https://github.com/sarangkharche/Intertool/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "mcp",
    "registry",
    "claude-code",
    "cursor",
    "prompt-templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@base-ui/react": "^1.3.0",
