# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/tests/e2e/.auth

# next.js
/.next/
/.next-*/
/.next-playwright/
/.next-build/
/out/

# fumadocs generated
/.source/

# production
/build
/apps/*/dist
/packages/*/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local database artifacts
.data/

# env files (can opt-in for committing if needed)
.env*.local

# cli build
cli/dist

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# registry settings (contains S3 secrets)
registry/settings.json

# cli build artifacts
cli/node_modules
cli/dist
registry/.index.json

# plugin/tool directories
.clerk/
.superpowers/
.claude/
.codex/config.toml

# Python hook runtime test caches
__pycache__/
