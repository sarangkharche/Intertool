{
  "name": "@intertool/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/app.ts",
  "scripts": {
    "dev:service": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
